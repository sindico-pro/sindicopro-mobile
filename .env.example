# URL completa do endpoint GraphQL do Nest.
# Em aparelho físico ou emulador, localhost aponta para o próprio aparelho.
# Use o IP da máquina na rede (Android emulator: 10.0.2.2).
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:7400/graphql

# Site aberto pelo item "Abrir no site" do menu. HTTPS, sem credenciais.
EXPO_PUBLIC_WEB_URL=https://sindicopro.com.br

# Bucket S3 das fotos de tarefa (o mesmo NEXT_PUBLIC_KANBAN_CARD_BUCKET_NAME da web).
EXPO_PUBLIC_KANBAN_CARD_BUCKET_NAME=
