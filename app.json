{
  "expo": {
    "name": "SindicoPro",
    "slug": "sindicopro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sindicopromobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sindicopro",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sindicopro",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "android": {
            "imageWidth": 176
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O SíndicoPro usa a câmera para fotos das tarefas.",
          "photosPermission": "O SíndicoPro acessa suas fotos para anexar às tarefas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b2ad1a07-b02f-4be6-be4b-a097eda50862"
      }
    },
    "owner": "rogerioazevedo"
  }
}
